<div class={{this.arrayClasses}}>
  {{#if this.shouldIncludeSlider}}
    <div class="value-input-array-sliders">
      {{#each @array.items as |item|~}}
        <ValueInputFader
          @item={{item}}
          @min={{@array.valueMin}}
          @max={{@array.valueMax}}
          @step={{@array.valueStep}}
          @displayScale={{@displayScale}}
        />
      {{~/each}}
    </div>
  {{/if}}
  {{#if this.shouldIncludeNumber}}
    <div class="value-input-array-numbers">
      {{#each @array.items as |item|~}}
        <ValueArrayInputNumber
          @item={{item}}
          @boundValue={{item.value}}
          @min={{@array.valueMin}}
          @max={{@array.valueMax}}
          @canBeEmpty={{true}}
          @step={{@array.valueStep}}
        />
      {{~/each}}
    </div>
  {{/if}}
  {{#if this.isTypeButton}}
    <div class="value-input-array-buttons">
      {{#each @array.items as |item|~}}
        <ValueArrayInputButton
          @item={{item}}
          @min={{@array.valueMin}}
          @max={{@array.valueMax}}
        />
      {{~/each}}
    </div>
  {{/if}}
</div>
