<div class="app-sidebar-section"><h4>Patch</h4></div>
<div class="app-sidebar-section">
  <ul>
    <li><ValueInputString @boundValue={{@patch.title}} @canBeEmpty={{false}} @target={{@patch}} @property="title" @valueUpdated={{this.titleChanged}} /></li>
    <li><button {{on "click" @removePatch}}>Delete Patch</button></li>
  </ul>
</div>
